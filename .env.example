# --- Required for live AI calls -------------------------------------------------
# Free key from Google AI Studio (https://aistudio.google.com/apikey) — no card.
# Get one, paste it here in your own .env (never commit .env).
GEMINI_API_KEY=paste-your-free-ai-studio-key-here

# --- Database -------------------------------------------------------------------
# Matches docker-compose.yml defaults. Override for a local Postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/imagematch

# --- Models (free tier) ----------------------------------------------------------
# Free-tier daily caps differ PER MODEL and change over time (e.g. at build time
# gemini-3.8-flash allowed only 20 generate-content calls/day, too few for the
# 46-image seed in one day). gemini-3.7-flash worked for live vision tagging.
# If you hit a 429 daily cap mid-seed: switch the model and re-run — the seed
# resumes and skips already-tagged images.
GEMINI_VISION_MODEL=gemini-3.7-flash
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# --- Behavior --------------------------------------------------------------------
# Dev/offline mode: deterministic fake vision + embeddings, no API key needed.
# NEVER enable for real evaluation — exists for tests and offline development.
MOCK_AI=false

# Per-image vision confidence below this is flagged, not trusted.
CONFIDENCE_FLOOR=0.70
# Similarity threshold is tuned by scripts/tune_thresholds.py and stored in
# config/thresholds.json; this env var overrides it if set.
MATCH_THRESHOLD=
# Estimated-cost budget guard: new batch jobs are refused once the logged
# estimated spend (at published list prices) exceeds this many USD.
COST_BUDGET_USD=5.00

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=4
# Courtesy delay between job items; raise if the free tier rate-limits you
# (e.g. 4.0 ≈ 15 vision calls/min). 0 = no pacing (fine for MOCK_AI/tests).
JOB_ITEM_PACE_SECONDS=0
